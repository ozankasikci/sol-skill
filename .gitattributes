# Exclude non-runtime files from `git archive` output.
#
# NOTE: skills/ and .claude-plugin/ are deliberately NOT export-ignored — Claude
# Code's /plugin install fetches this same git archive tarball, so removing them
# silently breaks installs.

__pycache__/    export-ignore
*.pyc           export-ignore
.DS_Store       export-ignore

# Repo-only docs and CI
.github/        export-ignore
CONTRIBUTING.md export-ignore
CHANGELOG.md    export-ignore

# Watcher tests are for contributors, not runtime. Safe to exclude because the
# only thing referencing them (CONTRIBUTING.md) is export-ignored too.
skills/sol/scripts/tests/  export-ignore

# Build config itself
.gitignore      export-ignore
.gitattributes  export-ignore

# NOTE: media/ is deliberately NOT export-ignored. README.md ships in the archive
# and references media/social-preview.png as its banner; stripping the image would
# leave a broken reference for 75KB of savings.
